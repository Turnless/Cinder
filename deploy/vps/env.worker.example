# /opt/cinder/.env.worker: settings for the Cinder worker on the VPS (chmod 600, owner root).
# Use the same values as Vercel. Never put SODEX_MASTER_PRIVATE_KEY here.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SOSOVALUE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# testnet or mainnet, the same as the site. Mainnet also needs ALLOW_MAINNET=true.
NEXT_PUBLIC_SODEX_NETWORK=testnet
ALLOW_MAINNET=

# Cinder's own SoDEX account and its trading key (from scripts/register-sodex-api-key.js)
USER_WALLET_ADDRESS=
SODEX_API_KEY_NAME=
SODEX_API_KEY_PRIVATE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

AUTO_TRADE_ENABLED=false
MAX_ALLOCATION_PER_TRADE=
STOP_LOSS_PERCENTAGE=
COOLDOWN_HOURS=
QTY_DECIMALS=
EDGE_CONFIG=
KILL_SWITCH_FAIL_CLOSED=
NEWS_TTL_HOURS=
ETF_FLOWS_TTL_HOURS=
PORT=
WORKER_SHUTDOWN_GRACE_MS=
