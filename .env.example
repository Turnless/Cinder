# ==============================================================================
# Cinder Environment Variables Template
# ==============================================================================

# 🔷 Data Layer: SoSoValue API
# Register at https://sosovalue.com and apply via Buildathon form for API access
SOSOVALUE_API_KEY=your_sosovalue_api_key

# 🗄️ Database Layer: Turso (libSQL)
# Get credentials from your Turso dashboard (turso db show <db-name>)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# 🟠 Execution Layer: SoDEX API (Cinder's own account, used by the automatic trader)
# Users never trade through these: they trade from their own SoDEX accounts in the browser.
# SODEX_MASTER_PRIVATE_KEY is your main wallet private key, used only for initial 
# setup tasks like registering API keys (addAPIKey/revokeAPIKey). Do NOT use it for daily signing.
SODEX_MASTER_PRIVATE_KEY=your_evm_master_wallet_private_key_0x...
USER_WALLET_ADDRESS=your_evm_wallet_address_0x...

# The API key the automatic trader signs with. Create it on your own computer with
# `node scripts/register-sodex-api-key.js`; it prints these values. It cannot withdraw or transfer.
SODEX_API_KEY_NAME=your_api_key_name
SODEX_API_KEY_PRIVATE_KEY=your_api_key_private_key_returned_from_addAPIKey

# Network for the whole deployment, server and browser: testnet or mainnet. Anything else means testnet.
# The worker needs it too.
NEXT_PUBLIC_SODEX_NETWORK=testnet
# User trading from their own SoDEX accounts (browser side)
# Cinder's SoDEX account ID (the builder that earns fees) and the fee requested on each
# order, in tenths of a basis point (50 = 0.05%). Leave the ID empty to trade without a builder fee.
NEXT_PUBLIC_SODEX_BUILDER_ID=
NEXT_PUBLIC_SODEX_BUILDER_FEE=50

# 🧠 Brain Layer: OpenAI-compatible LLM
# Required for story generation + narrative NLP classification
OPENAI_API_KEY=your_openai_api_key
# Optional: any OpenAI-compatible provider and model (defaults: https://api.openai.com/v1, mimo-v2.5)
OPENAI_BASE_URL=
OPENAI_MODEL=

# 🔔 Notification Layer: Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_symbol
# Required for the webhook: register it with scripts/set-telegram-webhook.js using the same value
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# ⚡ Trading & Risk Settings
NARRATIVE_TRADE_THRESHOLD=80        # Minimum narrative shift confidence to trade (0-100)
MAX_ALLOCATION_PER_TRADE=0.30       # Max portion of portfolio value allowed per trade (0.0 to 1.0)
STOP_LOSS_PERCENTAGE=0.08           # Trailing stop-loss percentage (0.08 = 8%)
COOLDOWN_HOURS=48                   # Minimum hours to wait between consecutive narrative trades
AUTO_TRADE_ENABLED=false            # Master switch: set to true to enable automated trading
INTERNAL_API_SECRET=change_me       # Secret for trusted POSTs to /api/trade, /api/stories and /api/narrative
QTY_DECIMALS=4                      # Decimal places for trade quantity
NEWS_TTL_HOURS=48                   # Hours to retain cached news before pruning
ETF_FLOWS_TTL_HOURS=24              # Hours to retain cached ETF flows before pruning
KILL_SWITCH_FAIL_CLOSED=true        # Whether kill-switch fails closed (paused) on Edge Config error
# Optional: Vercel Edge Config connection URL; set its trading_paused key to true to pause trading
EDGE_CONFIG=
